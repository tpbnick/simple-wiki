DATABASE_PATH=./wiki.db
UPLOADS_DIR=./uploads
PORT=3000

# BODY_SIZE_LIMIT=512M       # max POST body size (512M in Docker image; adapter-node default is 512K)

# ADMIN_PASSWORD=your-secure-password   # optional: initial admin password on first boot (min 8 chars; random if unset)

# PUBLIC_READ=false          # private wiki (default is public read — fine on a home LAN)
# WIKI_NAME=My Wiki          # display name in admin UI and backups
# NODE_ENV=production
# COOKIE_SECURE=true         # session cookies over HTTPS only (default true in production)
# COOKIE_SECURE=false        # plain HTTP (docker-compose sets this for local use)

# Self-hosting on LAN: defaults in docker-compose are enough (COOKIE_SECURE=false, public read).
# Internet-facing: HTTPS, COOKIE_SECURE=true, WIKI_ORIGIN, and often PUBLIC_READ=false.
# Plain HTTP Docker / LAN: server/start.mjs fixes CSRF when COOKIE_SECURE=false.
# Behind a reverse proxy with HTTPS, set the public URL and proxy headers:
# WIKI_ORIGIN=https://wiki.example.com
# PROTOCOL_HEADER=x-forwarded-proto
# HOST_HEADER=x-forwarded-host

# Behind a reverse proxy — pass the real client IP for rate limits:
# ADDRESS_HEADER=x-forwarded-for
# XFF_DEPTH=1

# PUBLIC_WIKI_LOCALE=en-US   # BCP 47 locale for formatted dates (client + server)
